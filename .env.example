# JudgeAI Backend Configuration
# Copy this file to .env and fill in your actual values

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_STORAGE_BUCKET=court-judgments

# Groq API Key (for LLM extraction)
GROQ_API_KEY=your-groq-api-key

# Environment
ENVIRONMENT=development
DEBUG=true

# PDF Processing
JUDGEAI_MAX_PARSE_PAGES=24
JUDGEAI_OCR_DPI=220
JUDGEAI_PDF_REQUEST_TIMEOUT_SEC=30

# CORS Origins (for local dev)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Optional: Background Worker Configuration
# REDIS_URL=redis://localhost:6379
# WORKER_CONCURRENCY=4
